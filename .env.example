# Extractor backend: rule | langchain
QUIZGEN_EXTRACTOR_BACKEND=langchain

# LLM provider: openai | mistral
QUIZGEN_LLM_PROVIDER=mistral

# Provider-specific model name
QUIZGEN_LLM_MODEL=devstral-medium-latest

# Set one of these depending on provider
MISTRAL_API_KEY=your_mistral_api_key
# OPENAI_API_KEY=your_openai_api_key

# UI + persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Legacy JWT secret (JWT Keys → Legacy): only needed if access tokens are still HS256
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_BUCKET=quiz-assets
# CORS: browser origin(s) allowed to call the API. Use production frontend URL when deployed.
UI_ALLOWED_ORIGIN=http://localhost:5173
# Optional: comma-separated list for multiple origins (e.g. Vercel preview + custom domain).
# UI_ALLOWED_ORIGINS=https://app.vercel.app,https://quiz.example.com
