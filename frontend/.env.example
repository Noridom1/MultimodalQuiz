# Used when the browser calls the API directly (production or tunnel).
# Leave unset for local dev: Vite proxies /api to localhost:8000 (see vite.config.js).
# No trailing slash.
# VITE_API_BASE_URL=https://your-api-host.example.com

# Supabase (public anon key — safe to expose in the built SPA).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
